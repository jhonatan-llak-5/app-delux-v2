# ============================================================================
# Delux — Variables de PRODUCCIÓN
# Copia este archivo a .env (en la carpeta del entorno) y rellena los valores.
#   cp .env.prod.example .env
# docker compose lo autocarga; corre:  docker compose -f docker-compose.prod.yml up -d --build
# ============================================================================

# ── Entorno: define el sufijo de contenedores e imágenes (delux_backend_staging, ...) ──
APP_ENV=staging

# ── Puerto del host donde se publica la web (el 80 está ocupado en tu VPS) ──
WEB_PORT=8080

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
# Genera una con: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIA-ESTA-CLAVE-LARGA-Y-ALEATORIA
JWT_SECRET_KEY=CAMBIA-ESTE-JWT

# Hosts permitidos. Dominio (apex + www) + IP del VPS por si accedes directo.
ALLOWED_HOSTS=deluxstyle.com,www.deluxstyle.com,TU_IP_DEL_VPS,localhost,127.0.0.1

# Orígenes de confianza para CSRF (admin de Django sobre HTTPS). Con esquema.
CSRF_TRUSTED_ORIGINS=https://deluxstyle.com,https://www.deluxstyle.com

# HTTPS: True — el TLS lo termina el nginx del HOST (:443) y reenvía
# X-Forwarded-Proto=https al contenedor. El redirect http->https también lo
# hace ese nginx del host, por eso SECURE_SSL_REDIRECT queda en False (evita
# el doble redirect).
SECURE_SSL=True
SECURE_SSL_REDIRECT=False

# ── Base de datos (interna, contenedor postgres) ────────────────────────────
DB_NAME=delux
DB_USER=delux
DB_PASSWORD=CAMBIA-ESTA-CLAVE-DB
DB_HOST=postgres
DB_PORT=5432

# ── Redis (interno) ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── URLs / CORS ─────────────────────────────────────────────────────────────
# Mismo origen que la web (el dominio canónico con HTTPS).
FRONTEND_URL=https://deluxstyle.com
CORS_ALLOWED_ORIGINS=https://deluxstyle.com

# ── Email (ajusta a tu proveedor SMTP cuando quieras enviar correos reales) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@deluxstyle.com

# ── Pagos PayPhone (opcional) ───────────────────────────────────────────────
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# ── Almacenamiento S3 (opcional). Si lo dejas vacío, se usan archivos locales
#    servidos por nginx (recomendado para empezar). ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ── Multi-tenant ────────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=delux

# ── Errores en producción (opcional) ────────────────────────────────────────
SENTRY_DSN=
